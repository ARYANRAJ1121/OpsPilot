# OpsPilot environment — copy to .env and fill in values as needed.
# The system runs fully offline without any of these set.

# Optional: enable LLM narrative enrichment (diagnosis / customer msg / rationale)
OPENAI_API_KEY=
OPSPILOT_LLM_ENABLED=true
OPSPILOT_LLM_MODEL=gpt-4o-mini
OPSPILOT_LLM_TEMPERATURE=0.1

# Confidence router: scores below this require human approval
OPSPILOT_CONFIDENCE_THRESHOLD=0.7

# Where JSONL incident traces are written
OPSPILOT_TRACE_DIR=trace_store
