# OpsPilot environment — copy to .env and fill in values as needed.
# The system runs fully offline without any of these set.

# Groq (free tier) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
OPSPILOT_LLM_ENABLED=true
OPSPILOT_LLM_MODEL=openai/gpt-oss-20b
OPSPILOT_LLM_TEMPERATURE=0.1

# Confidence router: scores below this require human approval
OPSPILOT_CONFIDENCE_THRESHOLD=0.7

# Where JSONL incident traces are written
OPSPILOT_TRACE_DIR=trace_store

# Slack Events API + Bolt (https://api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Comma-separated channel IDs; empty = allow all
SLACK_ALLOWED_CHANNELS=
SLACK_STATUS_POLL_SECONDS=5
SLACK_ACK_TIMEOUT_SECONDS=3
SLACK_MAX_INCIDENTS_PER_MINUTE=30
