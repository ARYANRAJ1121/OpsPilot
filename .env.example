# OpsPilot environment — copy to .env and fill in values as needed.
# $0 mode: leave Slack/Groq blank and use CLI + simulated tools only.
# Live free mode: see docs/FREE_SLACK_GROQ.md

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
OPSPILOT_LLM_ENABLED=true
OPSPILOT_LLM_MODEL=openai/gpt-oss-20b
OPSPILOT_LLM_TEMPERATURE=0.1

# Optional LLM tool/action planning (falls back to heuristics)
OPSPILOT_LLM_PLANNING=true
OPSPILOT_LLM_PLANNING_MODEL=llama-3.3-70b-versatile

# Guardrails (deterministic on by default; optional Groq judge uses free quota)
OPSPILOT_GUARDRAILS_ENABLED=true
OPSPILOT_GUARDRAILS_LLM=false

# Confidence router: scores below this require human approval
OPSPILOT_CONFIDENCE_THRESHOLD=0.7

# Where JSONL incident traces are written
OPSPILOT_TRACE_DIR=trace_store

# Durable HITL — SQLite checkpointer + JSON approval queue (survives restart)
OPSPILOT_CHECKPOINT_BACKEND=sqlite
OPSPILOT_CHECKPOINT_PATH=trace_store/checkpoints.sqlite
OPSPILOT_APPROVAL_QUEUE_PATH=trace_store/pending_approvals.json
# Optional token for GET/POST /api/approvals (Bearer or X-OpsPilot-Token)
OPSPILOT_APPROVAL_API_TOKEN=

# Remediation: simulated (default) | dry_run — real cloud via register_tool_override
OPSPILOT_REMEDIATION_MODE=simulated

# Slack Events API + Bolt (free workspace) — https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Comma-separated channel IDs; empty = allow all
SLACK_ALLOWED_CHANNELS=
SLACK_STATUS_POLL_SECONDS=5
SLACK_ACK_TIMEOUT_SECONDS=3
SLACK_MAX_INCIDENTS_PER_MINUTE=30

# Jira webhook shared secret (send as X-OpsPilot-Webhook-Secret or X-Hub-Signature)
JIRA_WEBHOOK_SECRET=

# GitHub webhook secret (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# Support tickets + logs/alertmanager webhooks (same shared-secret headers as Jira)
TICKETS_WEBHOOK_SECRET=
LOGS_WEBHOOK_SECRET=

# When true, reject webhooks if the secret is unset or invalid
OPSPILOT_WEBHOOK_REQUIRE_SIGNATURES=false
